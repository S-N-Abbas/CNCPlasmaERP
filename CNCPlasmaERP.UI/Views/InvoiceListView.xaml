<UserControl x:Class="CNCPlasmaERP.UI.Views.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="*"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16">
            <Grid Visibility="{Binding SelectedInvoiceDetail, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding SelectedInvoiceDetail.InvoiceNumber}" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                        <TextBlock Foreground="#667085" FontSize="12">
                            <Run Text="{Binding SelectedInvoiceDetail.Customer.Name, Mode=OneWay}"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding SelectedInvoiceDetail.Status, Mode=OneWay}"/>
                            <Run Text=" • Balance: "/>
                            <Run Text="{Binding SelectedInvoiceDetail.BalanceAmount, StringFormat=N2, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Print (A5)" Style="{StaticResource PrimaryButton}" Click="PrintButton_Click"/>
                </Grid>

                <Border Grid.Row="1" BorderBrush="#E4E7EC" BorderThickness="1" Background="#F2F2F2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                        <Viewbox Stretch="Uniform" MaxWidth="560" HorizontalAlignment="Center">
                            <Border Background="White">
                                <views:InvoicePrintView DataContext="{Binding PrintPreviewData}"/>
                            </Border>
                        </Viewbox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
