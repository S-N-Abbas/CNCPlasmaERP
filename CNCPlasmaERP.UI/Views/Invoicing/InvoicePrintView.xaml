<UserControl x:Class="CNCPlasmaERP.UI.Views.InvoicePrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560" Height="794" Background="White">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Company header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Settings.CompanyName}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding Settings.CompanyAddress}" FontSize="11" Foreground="#444444"/>
            <TextBlock FontSize="11" Foreground="#444444">
                <Run Text="{Binding Settings.CompanyPhone, Mode=OneWay}"/>
                <Run Text=" | "/>
                <Run Text="{Binding Settings.CompanyEmail, Mode=OneWay}"/>
            </TextBlock>
            <Rectangle Height="1" Fill="#333333" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Invoice meta + customer -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="BILL TO" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                <TextBlock Text="{Binding Invoice.Customer.Name}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Invoice.Customer.Address}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Invoice.Customer.Phone}" FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="INVOICE" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                <TextBlock FontSize="11" HorizontalAlignment="Right">
                    <Run Text="No: "/><Run Text="{Binding Invoice.InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock FontSize="11" HorizontalAlignment="Right">
                    <Run Text="Date: "/><Run Text="{Binding Invoice.InvoiceDate, StringFormat=dd-MMM-yyyy, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" HorizontalAlignment="Right">
                    <Run Text="Job #: "/><Run Text="{Binding Invoice.Job.JobNumber, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Items table header -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Description" FontSize="10" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" Text="Qty (Kg)" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="Rate" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="Amount" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
        </Grid>

        <!-- Items -->
        <StackPanel Grid.Row="3">
            <Rectangle Height="1" Fill="#333333" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Invoice.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding QuantityKg, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="{Binding RatePerKg, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Totals -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <Rectangle Height="1" Fill="#333333" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" FontSize="11" HorizontalAlignment="Right" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Invoice.SubTotal, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Invoice.TaxPercentage, StringFormat='Tax ({0}%)'}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,12,4"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Invoice.TaxAmount, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Grand Total" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,12,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Invoice.GrandTotal, StringFormat=N2}" FontSize="13" FontWeight="Bold" TextAlignment="Right"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Paid" FontSize="11" HorizontalAlignment="Right" Margin="0,4,12,4"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Invoice.PaidAmount, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Balance Due" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,12,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Invoice.BalanceAmount, StringFormat=N2}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"/>
            </Grid>

            <TextBlock Text="Thank you for your business." FontSize="10" Foreground="#888888" Margin="0,24,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
