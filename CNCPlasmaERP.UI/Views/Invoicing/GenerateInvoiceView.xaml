<UserControl x:Class="CNCPlasmaERP.UI.Views.GenerateInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Jobs ready to invoice (Completed status)" FontSize="13" Foreground="#667085" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Padding="16" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <Button Content="Generate Invoice" Style="{StaticResource PrimaryButton}"
                                Command="{Binding GenerateInvoiceCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding CompletedJobs}" SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job #" Binding="{Binding JobNumber}" Width="110"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding JobDate, StringFormat=dd-MMM-yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceCharges, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Carriage" Binding="{Binding CarriageCharges, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
