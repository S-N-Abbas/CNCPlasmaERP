<UserControl x:Class="CNCPlasmaERP.UI.Views.GenerateInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Subtitle Header -->
        <TextBlock Grid.Row="0"
                   Text="Jobs ready to invoice (Completed status)"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                   Margin="0,0,0,12" />

        <!-- Main Card Container -->
        <Border Grid.Row="1"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1">
            <DockPanel>
                <!-- Bottom Action Bar -->
                <Border DockPanel.Dock="Bottom"
                        Padding="16,12"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="0,1,0,0"
                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <!-- Error Message Display -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#D92D20"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                        <!-- Primary Action Button -->
                        <Button Content="Generate Invoice"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GenerateInvoiceCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Completed Jobs DataGrid -->
                <DataGrid ItemsSource="{Binding CompletedJobs}"
                          SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="38"
                          Style="{StaticResource MahApps.Styles.DataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job #"
                                            Binding="{Binding JobNumber}"
                                            Width="120" />

                        <DataGridTextColumn Header="Customer"
                                            Binding="{Binding Customer.Name}"
                                            Width="*" />

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding JobDate, StringFormat=dd-MMM-yyyy}"
                                            Width="120" />

                        <DataGridTextColumn Header="Service"
                                            Binding="{Binding ServiceCharges, StringFormat=N2}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right" />
                                    <Setter Property="Margin"
                                            Value="0,0,12,0" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Carriage"
                                            Binding="{Binding CarriageCharges, StringFormat=N2}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right" />
                                    <Setter Property="Margin"
                                            Value="0,0,12,0" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>