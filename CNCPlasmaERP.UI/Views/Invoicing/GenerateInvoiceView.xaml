<UserControl x:Class="CNCPlasmaERP.UI.Views.GenerateInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Completed jobs ready to invoice"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1">
                <DataGrid ItemsSource="{Binding CompletedJobs}"
                          SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="38"
                          SelectionMode="Single"
                          Style="{StaticResource MahApps.Styles.DataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job #" Binding="{Binding JobNumber}" Width="120" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding JobDate, StringFormat=dd-MMM-yyyy}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    Padding="18">
                <Grid>
                    <Grid Visibility="{Binding SelectedJob, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Invoice Preview" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource MahApps.Brushes.Text}" Margin="0,0,0,16" />
                            <TextBlock Text="Job number" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                            <TextBlock Text="{Binding SelectedJob.JobNumber}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,12" />
                            <TextBlock Text="Customer" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                            <TextBlock Text="{Binding SelectedJob.Customer.Name}" FontSize="14" Margin="0,2,0,12" />
                            <TextBlock Text="Completed on" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                            <TextBlock Text="{Binding SelectedJob.JobDate, StringFormat=dd-MMM-yyyy}" FontSize="14" Margin="0,2,0,12" />
                            <TextBlock Text="Description" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                            <TextBlock Text="{Binding SelectedJob.Description}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,12" />
                            <TextBlock Text="Charges" FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Service" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedJob.ServiceCharges, StringFormat=N2}" />
                                <TextBlock Grid.Row="1" Text="Carriage" Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedJob.CarriageCharges, StringFormat=N2}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                            <Button Content="Generate Invoice" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GenerateInvoiceCommand}" Height="38"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding SelectedJob, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="Select a completed job" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="Review it here, then generate its invoice."
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
