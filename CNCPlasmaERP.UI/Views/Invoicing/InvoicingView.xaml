<UserControl x:Class="CNCPlasmaERP.UI.Views.InvoicingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">

    <TabControl Margin="0"
                Background="Transparent"
                BorderThickness="0"
                Style="{StaticResource MahApps.Styles.TabControl}"
                mah:HeaderedControlHelper.HeaderFontSize="14">

        <!-- Tab 1: Generate Invoice -->
        <TabItem Header="Generate Invoice"
                 DataContext="{Binding GenerateInvoice}"
                 Style="{StaticResource MahApps.Styles.TabItem}">
            <views:GenerateInvoiceView />
        </TabItem>

        <!-- Tab 2: Invoices List -->
        <TabItem Header="Invoices"
                 DataContext="{Binding InvoiceList}"
                 Style="{StaticResource MahApps.Styles.TabItem}">
            <views:InvoiceListView />
        </TabItem>

        <!-- Tab 3: Payments -->
        <TabItem Header="Payments"
                 DataContext="{Binding Payments}"
                 Style="{StaticResource MahApps.Styles.TabItem}">
            <views:PaymentsView />
        </TabItem>

    </TabControl>
</UserControl>