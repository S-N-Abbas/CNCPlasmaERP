<UserControl x:Class="CNCPlasmaERP.UI.Views.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Invoices List DataGrid -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Invoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="38"
                      Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="110" />

                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding Customer.Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="90" />

                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding GrandTotal, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,12,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Selected Invoice Details & Print Preview -->
        <Border Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Padding="18">
            <Grid Visibility="{Binding SelectedInvoiceDetail, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Actions & Meta Info -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedInvoiceDetail.InvoiceNumber}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        <TextBlock Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   FontSize="13"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding SelectedInvoiceDetail.Customer.Name, Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding SelectedInvoiceDetail.Status, Mode=OneWay}" />
                            <Run Text=" • Balance: " />
                            <Run Text="{Binding SelectedInvoiceDetail.BalanceAmount, StringFormat=N2, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Print Action Button -->
                    <Button Grid.Column="1"
                            Content="Print (A5)"
                            Style="{StaticResource PrimaryButton}"
                            Click="PrintButton_Click"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Document Preview Frame -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20">
                        <Viewbox Stretch="Uniform"
                                 MaxWidth="560"
                                 HorizontalAlignment="Center">
                            <Border Background="White"
                                    Effect="{DynamicResource MahApps.DropShadow.DataGrid}">
                                <views:InvoicePrintView DataContext="{Binding PrintPreviewData}" />
                            </Border>
                        </Viewbox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>