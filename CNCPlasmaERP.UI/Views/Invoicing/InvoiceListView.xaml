<UserControl x:Class="CNCPlasmaERP.UI.Views.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Invoices List DataGrid -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Invoices}"
                      SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="38"
                      Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="110" />

                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding Customer.Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="90" />

                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding GrandTotal, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,12,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Selected Invoice Details & Print Preview -->
        <Border Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Padding="18">
            <Grid Visibility="{Binding SelectedInvoiceDetail, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Actions & Meta Info -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedInvoiceDetail.InvoiceNumber}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}" />
                        <TextBlock Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   FontSize="13"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding SelectedInvoiceDetail.Customer.Name, Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding SelectedInvoiceDetail.Status, Mode=OneWay}" />
                            <Run Text=" • Balance: " />
                            <Run Text="{Binding SelectedInvoiceDetail.BalanceAmount, StringFormat=N2, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Print Action Button -->
                    <Button Grid.Column="1"
                            Content="Print (A5)"
                            Style="{StaticResource PrimaryButton}"
                            Click="PrintButton_Click"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Document Preview Frame -->
                <Border Grid.Row="1"
                        Padding="10"
                        Margin="0,0,0,10"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        IsEnabled="{Binding IsAdjustable}">
                    <StackPanel>
                        <TextBlock Text="Invoice correction" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AdjustedOtherCharges, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Other charges" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding AdjustedDiscountAmount, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Discount" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="2" Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Required reason for correction" Margin="0,0,6,0"/>
                            <Button Grid.Column="3" Content="Save Correction" Command="{Binding SaveAdjustmentCommand}"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                        </Grid>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#16804A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <Expander Header="Correction history" Margin="0,5,0,0">
                            <DataGrid ItemsSource="{Binding AdjustmentHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" RowHeight="28" Height="90" BorderThickness="0"
                                      Style="{StaticResource MahApps.Styles.DataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding AdjustmentDate, StringFormat=dd-MMM-yyyy HH:mm}" Width="140"/>
                                    <DataGridTextColumn Header="Previous total" Binding="{Binding PreviousGrandTotal, StringFormat=N2}" Width="125"/>
                                    <DataGridTextColumn Header="New total" Binding="{Binding NewGrandTotal, StringFormat=N2}" Width="110"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20">
                        <Viewbox Stretch="Uniform"
                                 MaxWidth="560"
                                 HorizontalAlignment="Center">
                            <Border Background="White"
                                    Effect="{DynamicResource MahApps.DropShadow.DataGrid}">
                                <views:InvoicePrintView DataContext="{Binding PrintPreviewData}" />
                            </Border>
                        </Viewbox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
