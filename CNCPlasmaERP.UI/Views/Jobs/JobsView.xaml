<UserControl x:Class="CNCPlasmaERP.UI.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter + New Job Header Control Strip -->
        <Border Grid.Row="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <!-- Filter Status -->
                <StackPanel Width="150"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Label"
                              mah:TextBoxHelper.Watermark="Filter Status"
                              mah:TextBoxHelper.UseFloatingWatermark="True"
                              FontSize="13"
                              Style="{StaticResource MahApps.Styles.ComboBox}" />
                </StackPanel>

                <!-- New Job Customer -->
                <StackPanel Width="200"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding NewJobCustomer}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name"
                              StaysOpenOnEdit="True"
                              DisplayMemberPath="Name"
                              mah:TextBoxHelper.Watermark="Customer"
                              mah:TextBoxHelper.UseFloatingWatermark="True"
                              FontSize="13"
                              Style="{StaticResource MahApps.Styles.ComboBox}" />
                </StackPanel>

                <!-- Service Charges Input -->
                <StackPanel Width="120"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding NewJobServiceCharges, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Service Charges"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Style="{StaticResource MahApps.Styles.TextBox}" />
                </StackPanel>

                <!-- Carriage Charges Input -->
                <StackPanel Width="120"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding NewJobCarriageCharges, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Carriage Charges"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Style="{StaticResource MahApps.Styles.TextBox}" />
                </StackPanel>

                <!-- Description Input -->
                <StackPanel Width="200"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding NewJobDescription, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Description (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Style="{StaticResource MahApps.Styles.TextBox}" />
                </StackPanel>

                <!-- Action Button -->
                <Button Content="Create Job"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom"
                        Height="36"
                        Width="100"
                        Command="{Binding CreateJobCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>
        </Border>

        <!-- Main View Split (Job List + Job Detail) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Job List DataGrid -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    Margin="0,0,16,0">
                <DataGrid ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="38"
                          SelectionMode="Single"
                          Style="{StaticResource MahApps.Styles.DataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job #"
                                            Binding="{Binding JobNumber}"
                                            Width="110" />

                        <DataGridTextColumn Header="Customer"
                                            Binding="{Binding Customer.Name}"
                                            Width="*" />

                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="90" />

                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding JobDate, StringFormat=dd-MMM-yyyy}"
                                            Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Job Details View -->
            <Border Grid.Column="1"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                    BorderThickness="1"
                    Padding="18">
                <Grid Visibility="{Binding SelectedJobDetail, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Job Detail Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedJobDetail.JobNumber}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MahApps.Brushes.Text}" />
                            <TextBlock Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                       FontSize="13"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding SelectedJobDetail.Customer.Name, Mode=OneWay}" />
                                <Run Text=" • " />
                                <Run Text="{Binding SelectedJobDetail.Status, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Mark Completed"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Command="{Binding MarkCompletedCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                            <Button Content="Cancel Job"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelJobCommand}"
                                    Height="30"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Add Material Usage Sub-Form -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource MahApps.Brushes.Gray10}"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Add Material Usage"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MahApps.Brushes.Text}"
                                       Margin="0,0,0,12" />

                            <UniformGrid Columns="3"
                                         Rows="2">
                                <!-- Material Dropdown -->
                                <ComboBox ItemsSource="{Binding Materials}"
                                          SelectedItem="{Binding UsageMaterial}"
                                          DisplayMemberPath="Name"
                                          mah:TextBoxHelper.Watermark="Material"
                                          mah:TextBoxHelper.UseFloatingWatermark="True"
                                          FontSize="12"
                                          Margin="0,0,8,10"
                                          Style="{StaticResource MahApps.Styles.ComboBox}" />

                                <!-- Weight Used -->
                                <TextBox Text="{Binding UsageWeightKg, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="Weight Used (Kg)"
                                         mah:TextBoxHelper.UseFloatingWatermark="True"
                                         FontSize="12"
                                         Margin="0,0,8,10"
                                         Style="{StaticResource MahApps.Styles.TextBox}" />

                                <!-- Sheets Used -->
                                <TextBox Text="{Binding UsageSheetsUsed, Converter={StaticResource IntegerTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="Sheets Used (optional)"
                                         mah:TextBoxHelper.UseFloatingWatermark="True"
                                         FontSize="12"
                                         Margin="0,0,0,10"
                                         Style="{StaticResource MahApps.Styles.TextBox}" />

                                <!-- Selling Rate -->
                                <TextBox Text="{Binding UsageSellingRatePerKg, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="Selling Rate / Kg"
                                         mah:TextBoxHelper.UseFloatingWatermark="True"
                                         FontSize="12"
                                         Margin="0,0,8,0"
                                         Style="{StaticResource MahApps.Styles.TextBox}" />

                                <!-- Scrap Generated -->
                                <TextBox Text="{Binding UsageScrapGeneratedKg, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                         mah:TextBoxHelper.Watermark="Scrap Generated (Kg)"
                                         mah:TextBoxHelper.UseFloatingWatermark="True"
                                         FontSize="12"
                                         Margin="0,0,8,0"
                                         Style="{StaticResource MahApps.Styles.TextBox}" />

                                <!-- Add Usage Button -->
                                <Button Content="Add Usage"
                                        Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Bottom"
                                        Height="32"
                                        Command="{Binding AddUsageCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                            </UniformGrid>

                            <!-- Error Display -->
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#D92D20"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- Material Usages DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SelectedJobUsages}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                              RowHeight="36"
                              Style="{StaticResource MahApps.Styles.DataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material"
                                                Binding="{Binding Material.Name}"
                                                Width="*" />

                            <DataGridTextColumn Header="Weight (Kg)"
                                                Binding="{Binding WeightUsedKg, StringFormat=N2}"
                                                Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Right" />
                                        <Setter Property="Margin"
                                                Value="0,0,10,0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Cost/Kg"
                                                Binding="{Binding CostRatePerKg, StringFormat=N2}"
                                                Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Right" />
                                        <Setter Property="Margin"
                                                Value="0,0,10,0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Sell/Kg"
                                                Binding="{Binding SellingRatePerKg, StringFormat=N2}"
                                                Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Right" />
                                        <Setter Property="Margin"
                                                Value="0,0,10,0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Scrap (Kg)"
                                                Binding="{Binding ScrapGeneratedKg, StringFormat=N2}"
                                                Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Right" />
                                        <Setter Property="Margin"
                                                Value="0,0,10,0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Profit"
                                                Binding="{Binding ProfitAmount, StringFormat=N2}"
                                                Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Right" />
                                        <Setter Property="Margin"
                                                Value="0,0,10,0" />
                                        <Setter Property="VerticalAlignment"
                                                Value="Center" />
                                        <Setter Property="FontWeight"
                                                Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header=""
                                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="6,2"
                                                FontSize="11"
                                                Command="{Binding DataContext.RemoveUsageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary Footer -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <TextBlock Text="Service Charges: "
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   FontSize="13" />
                        <TextBlock Text="{Binding SelectedJobDetail.ServiceCharges, StringFormat=N2}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   Margin="0,0,20,0" />

                        <TextBlock Text="Carriage Charges: "
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   FontSize="13" />
                        <TextBlock Text="{Binding SelectedJobDetail.CarriageCharges, StringFormat=N2}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>