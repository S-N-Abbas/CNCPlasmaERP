<UserControl x:Class="CNCPlasmaERP.UI.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter + New Job strip -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="150" Margin="0,0,16,0">
                    <TextBlock Text="Status" FontSize="12" Foreground="#344054" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Label" Margin="0"/>
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,16,0">
                    <TextBlock Text="New Job — Customer" FontSize="12" Foreground="#344054" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding NewJobCustomer}" DisplayMemberPath="Name" Margin="0"/>
                </StackPanel>

                <StackPanel Width="110" Margin="0,0,16,0">
                    <TextBlock Text="Service Charges" FontSize="12" Foreground="#344054" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewJobServiceCharges, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>

                <StackPanel Width="110" Margin="0,0,16,0">
                    <TextBlock Text="Carriage Charges" FontSize="12" Foreground="#344054" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewJobCarriageCharges, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>

                <StackPanel Width="190" Margin="0,0,16,0">
                    <TextBlock Text="Description (optional)" FontSize="12" Foreground="#344054" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewJobDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </StackPanel>

                <Button Content="Create Job" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="34"
                        Command="{Binding CreateJobCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Job list -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,0,16,0">
                <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job #" Binding="{Binding JobNumber}" Width="110"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding JobDate, StringFormat=dd-MMM-yyyy}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Job detail -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16">
                <Grid Visibility="{Binding SelectedJobDetail, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedJobDetail.JobNumber}" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                            <TextBlock Foreground="#667085" FontSize="12">
                                <Run Text="{Binding SelectedJobDetail.Customer.Name, Mode=OneWay}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding SelectedJobDetail.Status, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Mark Completed" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Command="{Binding MarkCompletedCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Content="Cancel Job" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelJobCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Add usage form -->
                    <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Add Material Usage" FontSize="13" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,8"/>
                            <UniformGrid Columns="3" Rows="2">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Material" FontSize="11" Foreground="#667085"/>
                                    <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding UsageMaterial}" DisplayMemberPath="Name" Margin="0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Weight Used (Kg)" FontSize="11" Foreground="#667085"/>
                                    <TextBox Text="{Binding UsageWeightKg, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Sheets Used (optional)" FontSize="11" Foreground="#667085"/>
                                    <TextBox Text="{Binding UsageSheetsUsed, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Selling Rate / Kg" FontSize="11" Foreground="#667085"/>
                                    <TextBox Text="{Binding UsageSellingRatePerKg, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Scrap Generated (Kg)" FontSize="11" Foreground="#667085"/>
                                    <TextBox Text="{Binding UsageScrapGeneratedKg, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                </StackPanel>
                                <Button Content="Add Usage" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="30"
                                        Command="{Binding AddUsageCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                            </UniformGrid>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Usages grid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedJobUsages}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E4E7EC" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Material" Binding="{Binding Material.Name}" Width="*"/>
                            <DataGridTextColumn Header="Weight (Kg)" Binding="{Binding WeightUsedKg, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Cost/Kg" Binding="{Binding CostRatePerKg, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Sell/Kg" Binding="{Binding SellingRatePerKg, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Scrap (Kg)" Binding="{Binding ScrapGeneratedKg, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Profit" Binding="{Binding ProfitAmount, StringFormat=N2}" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="6,4" FontSize="11"
                                                Command="{Binding DataContext.RemoveUsageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer totals -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="Service: " Foreground="#667085"/>
                        <TextBlock Text="{Binding SelectedJobDetail.ServiceCharges, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Text="Carriage: " Foreground="#667085"/>
                        <TextBlock Text="{Binding SelectedJobDetail.CarriageCharges, StringFormat=N2}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
