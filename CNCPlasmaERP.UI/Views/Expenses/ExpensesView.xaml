<UserControl x:Class="CNCPlasmaERP.UI.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <TabControl Margin="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
        <TabItem Header="Expenses" DataContext="{Binding ExpenseList}">
            <views:ExpenseListView/>
        </TabItem>
        <TabItem Header="Wages" DataContext="{Binding Wages}">
            <views:WagesView/>
        </TabItem>
    </TabControl>
</UserControl>
