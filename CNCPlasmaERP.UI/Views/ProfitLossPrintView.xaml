<UserControl x:Class="CNCPlasmaERP.UI.Views.ProfitLossPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="794" Height="1123" Background="White">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Settings.CompanyName}" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Profit &amp; Loss Report" FontSize="16" Foreground="#444444" Margin="0,4,0,0"/>
            <TextBlock FontSize="12" Foreground="#667085" Margin="0,4,0,0">
                <Run Text="Period: "/>
                <Run Text="{Binding Summary.FromDate, StringFormat=dd-MMM-yyyy, Mode=OneWay}"/>
                <Run Text=" to "/>
                <Run Text="{Binding Summary.ToDate, StringFormat=dd-MMM-yyyy, Mode=OneWay}"/>
            </TextBlock>
            <Rectangle Height="1" Fill="#333333" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Summary -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Material Revenue" FontSize="12"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Summary.MaterialRevenue, StringFormat=N2}" FontSize="12" TextAlignment="Right"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Service Revenue" FontSize="12"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Summary.ServiceRevenue, StringFormat=N2}" FontSize="12" TextAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Carriage Revenue" FontSize="12"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Summary.CarriageRevenue, StringFormat=N2}" FontSize="12" TextAlignment="Right"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Scrap Income" FontSize="12"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Summary.ScrapIncome, StringFormat=N2}" FontSize="12" TextAlignment="Right"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Total Revenue" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Summary.TotalRevenue, StringFormat=N2}" FontSize="13" FontWeight="Bold" TextAlignment="Right" Margin="0,6,0,0"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Material Cost" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Summary.MaterialCost, StringFormat=N2}" FontSize="12" TextAlignment="Right" Margin="0,10,0,0"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Gross Profit" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Summary.GrossProfit, StringFormat=N2}" FontSize="13" FontWeight="Bold" TextAlignment="Right" Margin="0,6,0,0"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Operating Expenses" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Summary.TotalExpenses, StringFormat=N2}" FontSize="12" TextAlignment="Right" Margin="0,10,0,0"/>

            <Rectangle Grid.Row="8" Grid.ColumnSpan="2" Height="1" Fill="#333333" Margin="0,10,0,10"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="NET PROFIT" FontSize="15" FontWeight="Bold"/>
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Summary.NetProfit, StringFormat=N2}" FontSize="15" FontWeight="Bold" TextAlignment="Right"/>
        </Grid>

        <!-- By-material table header -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Profit by Material" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Material" FontSize="10" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="Weight (Kg)" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="Revenue" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="Cost" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="Profit" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="Margin" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
            </Grid>
            <Rectangle Height="1" Fill="#333333" Margin="0,0,0,6"/>
        </StackPanel>

        <!-- By-material rows -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding MaterialLines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="11">
                            <Run Text="{Binding MaterialName, Mode=OneWay}"/>
                            <Run Text=" ("/><Run Text="{Binding Gauge, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding TotalWeightKg, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalRevenue, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalCost, StringFormat=N2}" FontSize="11" TextAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding TotalProfit, StringFormat=N2}" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{Binding ProfitMarginPercent, StringFormat=N1}" FontSize="11" TextAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
