<UserControl x:Class="CNCPlasmaERP.UI.Views.StockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"
                        Command="{Binding LoadCommand}"
                        Height="36"
                        Width="100"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Content="Print (A4)" Style="{StaticResource PrimaryButton}" Click="PrintButton_Click"
                        Height="36"
                        Width="100" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Materials}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                    <DataGridTextColumn Header="Gauge" Binding="{Binding Gauge}" Width="90"/>
                    <DataGridTextColumn Header="Stock (Kg)" Binding="{Binding CurrentStockKg, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Sheets" Binding="{Binding CurrentStockCount}" Width="80"/>
                    <DataGridTextColumn Header="Reorder (Kg)" Binding="{Binding ReorderLevelKg, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
