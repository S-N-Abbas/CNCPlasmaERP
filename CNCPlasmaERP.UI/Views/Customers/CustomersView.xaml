<UserControl x:Class="CNCPlasmaERP.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <TabControl Margin="0" Background="Transparent" BorderThickness="0">
        <TabItem Header="Customers" DataContext="{Binding CustomerList}">
            <views:CustomerListView/>
        </TabItem>
        <TabItem Header="Ledger" DataContext="{Binding Ledger}">
            <views:CustomerLedgerView/>
        </TabItem>
    </TabControl>
</UserControl>
