<UserControl x:Class="CNCPlasmaERP.UI.Views.InvoicingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <TabControl Margin="0" Background="Transparent" BorderThickness="0">
        <TabItem Header="Generate Invoice" DataContext="{Binding GenerateInvoice}">
            <views:GenerateInvoiceView/>
        </TabItem>
        <TabItem Header="Invoices" DataContext="{Binding InvoiceList}">
            <views:InvoiceListView/>
        </TabItem>
        <TabItem Header="Payments" DataContext="{Binding Payments}">
            <views:PaymentsView/>
        </TabItem>
    </TabControl>
</UserControl>
