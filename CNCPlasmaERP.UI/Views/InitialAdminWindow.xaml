<mah:MetroWindow x:Class="CNCPlasmaERP.UI.Views.InitialAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Set up administrator" Height="440" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28">
        <TextBlock Text="Create the first administrator" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Choose a strong password. There is no default administrator password." TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="Full name"/><TextBox x:Name="FullNameBox" Margin="0,4,0,10"/>
        <TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Text="admin" Margin="0,4,0,10"/>
        <TextBlock Text="Password (at least 12 characters)"/><PasswordBox x:Name="PasswordBox" Margin="0,4,0,10"/>
        <TextBlock Text="Confirm password"/><PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,10"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Content="Create administrator" Height="36" Click="Create_Click"/>
    </StackPanel>
</mah:MetroWindow>
