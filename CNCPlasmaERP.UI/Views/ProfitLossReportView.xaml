<UserControl x:Class="CNCPlasmaERP.UI.Views.ProfitLossReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="150" Margin="0,0,16,0">
                    <TextBlock Text="From" FontSize="12" Foreground="#344054"/>
                    <DatePicker SelectedDate="{Binding FromDate}"/>
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,16,0">
                    <TextBlock Text="To" FontSize="12" Foreground="#344054"/>
                    <DatePicker SelectedDate="{Binding ToDate}"/>
                </StackPanel>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="34" Margin="0,0,12,0"
                        Command="{Binding LoadCommand}"
                        Width="100"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Content="Print (A4)" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="34"
                        Width="100"
                        Click="PrintButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Revenue" FontSize="11" Foreground="#667085"/>
                    <TextBlock Text="{Binding Summary.TotalRevenue, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Material Cost" FontSize="11" Foreground="#667085"/>
                    <TextBlock Text="{Binding Summary.MaterialCost, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Gross Profit" FontSize="11" Foreground="#667085"/>
                    <TextBlock Text="{Binding Summary.GrossProfit, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#067647"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Expenses" FontSize="11" Foreground="#667085"/>
                    <TextBlock Text="{Binding Summary.TotalExpenses, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#D92D20"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Net Profit" FontSize="11" Foreground="#667085"/>
                    <TextBlock Text="{Binding Summary.NetProfit, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- By-material grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1">
            <DataGrid ItemsSource="{Binding MaterialLines}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="Gauge" Binding="{Binding Gauge}" Width="80"/>
                    <DataGridTextColumn Header="Weight (Kg)" Binding="{Binding TotalWeightKg, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Revenue" Binding="{Binding TotalRevenue, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Cost" Binding="{Binding TotalCost, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Profit" Binding="{Binding TotalProfit, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Margin %" Binding="{Binding ProfitMarginPercent, StringFormat=N1}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
