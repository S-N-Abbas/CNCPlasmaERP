<mah:MetroWindow x:Class="CNCPlasmaERP.UI.Views.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Change password" Height="380" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28">
        <TextBlock Text="Password change required" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Set a new password to continue. Use at least 12 characters." TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Text="Current password"/><PasswordBox x:Name="CurrentPasswordBox" Margin="0,4,0,10"/>
        <TextBlock Text="New password"/><PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,10"/>
        <TextBlock Text="Confirm new password"/><PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,10"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Content="Change password" Height="36" Click="Change_Click"/>
    </StackPanel>
</mah:MetroWindow>
