<UserControl x:Class="CNCPlasmaERP.UI.Views.QuotationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Quotation list -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Quotations" FontSize="15" FontWeight="SemiBold" Foreground="#101828" VerticalAlignment="Center"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,6" FontSize="12"
                        Command="{Binding LoadCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Quotations}" SelectedItem="{Binding SelectedQuotation}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quote #" Binding="{Binding QuotationNumber}" Width="110"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding EstimatedTotal, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Right side: Details tab + New Quotation tab -->
        <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="Transparent" BorderThickness="0">

            <!-- ============ DETAILS ============ -->
            <TabItem Header="Details">
                <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16" Margin="0,8,0,0">
                    <Grid Visibility="{Binding SelectedQuotationDetail, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header + actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedQuotationDetail.QuotationNumber}" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                                <TextBlock Foreground="#667085" FontSize="12">
                                    <Run Text="{Binding SelectedQuotationDetail.Customer.Name, Mode=OneWay}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding SelectedQuotationDetail.Status, Mode=OneWay}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding SelectedQuotationDetail.QuotationDate, StringFormat=dd-MMM-yyyy, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="#667085" FontSize="12"
                                           Text="{Binding SelectedQuotationDetail.ExpiryDate, StringFormat='Valid until {0:dd-MMM-yyyy}'}"
                                           Visibility="{Binding SelectedQuotationDetail.ExpiryDate, Converter={StaticResource NullToVisibilityConverter}}"/>
                                <TextBlock Foreground="#067647" FontSize="12" FontWeight="SemiBold"
                                           Text="{Binding SelectedQuotationDetail.ConvertedToJob.JobNumber, StringFormat='Converted to job {0}'}"
                                           Visibility="{Binding SelectedQuotationDetail.ConvertedToJob, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Mark as Sent" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding MarkAsSentCommand}"/>
                                <Button Content="Convert to Job" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ConvertToJobCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status / error messages -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#067647" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Items -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedQuotationDetail.Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E4E7EC" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Material" Binding="{Binding Material.Name}" Width="130"/>
                                <DataGridTextColumn Header="Kg" Binding="{Binding EstimatedWeightKg, StringFormat=N2}" Width="70"/>
                                <DataGridTextColumn Header="Rate/Kg" Binding="{Binding EstimatedRatePerKg, StringFormat=N2}" Width="80"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding EstimatedAmount, StringFormat=N2}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Totals -->
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <TextBlock Text="{Binding SelectedQuotationDetail.Notes}" Foreground="#667085" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Service: " Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedQuotationDetail.EstimatedServiceCharges, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <TextBlock Text="Carriage: " Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedQuotationDetail.EstimatedCarriageCharges, StringFormat=N2}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                <TextBlock Text="Total: " Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedQuotationDetail.EstimatedTotal, StringFormat=N2}" FontWeight="Bold" Foreground="#101828"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============ NEW QUOTATION ============ -->
            <TabItem Header="New Quotation">
                <Border Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Quotation details" FontSize="15" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Customer" FontSize="12" Foreground="#344054"/>
                                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding NewCustomer}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Valid until (optional)" FontSize="12" Foreground="#344054"/>
                                    <DatePicker SelectedDate="{Binding NewExpiryDate}" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Service charges" FontSize="12" Foreground="#344054"/>
                                    <TextBox Text="{Binding NewServiceCharges, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Carriage charges" FontSize="12" Foreground="#344054"/>
                                    <TextBox Text="{Binding NewCarriageCharges, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Notes (optional)" FontSize="12" Foreground="#344054"/>
                            <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="46" TextWrapping="Wrap"/>

                            <!-- Item entry -->
                            <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                                <StackPanel>
                                    <TextBlock Text="Add an item" FontSize="13" FontWeight="SemiBold" Foreground="#344054" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Description" FontSize="11" Foreground="#667085"/>
                                            <TextBox Text="{Binding ItemDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Material (optional)" FontSize="11" Foreground="#667085"/>
                                            <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding ItemMaterial}" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Weight (Kg)" FontSize="11" Foreground="#667085"/>
                                            <TextBox Text="{Binding ItemWeightKg, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Rate / Kg" FontSize="11" Foreground="#667085"/>
                                            <TextBox Text="{Binding ItemRatePerKg, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Amount" FontSize="11" Foreground="#667085"/>
                                            <TextBox Text="{Binding ItemAmount, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                        </StackPanel>
                                        <Button Grid.Column="6" Content="Add Item" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="34"
                                                Command="{Binding AddDraftItemCommand}"/>
                                    </Grid>

                                    <TextBlock Text="Weight × rate fills in the amount automatically. For a lump-sum item, leave weight and rate empty and type the amount."
                                               FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Draft items -->
                            <DataGrid ItemsSource="{Binding DraftItems}" AutoGenerateColumns="False" IsReadOnly="True" Height="150"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E4E7EC" RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Material" Binding="{Binding Material.Name}" Width="120"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding EstimatedAmount, StringFormat=N2}" Width="90"/>
                                    <DataGridTemplateColumn Header="" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11"
                                                        Command="{Binding DataContext.RemoveDraftItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">
                                <TextBlock Text="Estimated total: " Foreground="#667085" FontSize="13"/>
                                <TextBlock Text="{Binding DraftTotal, StringFormat=N2}" FontWeight="Bold" FontSize="13" Foreground="#101828"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                            <Button Content="Create Quotation" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CreateQuotationCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
