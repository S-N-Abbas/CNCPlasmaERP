<UserControl x:Class="CNCPlasmaERP.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- View Title -->
        <TextBlock Grid.Row="0"
                   Text="Application Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600"
                        HorizontalAlignment="Left"
                        Visibility="{Binding Settings, Converter={StaticResource NullToVisibilityConverter}}">

                <!-- Section 1: Company Information -->
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Company Information"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   Margin="0,0,0,16" />

                        <!-- Company Name -->
                        <TextBox Text="{Binding Settings.CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Company Name"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 FontSize="13"
                                 Margin="0,0,0,12"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />

                        <!-- Address -->
                        <TextBox Text="{Binding Settings.CompanyAddress, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Company Address"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 AcceptsReturn="True"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 FontSize="13"
                                 Margin="0,0,0,12"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />

                        <!-- Phone -->
                        <TextBox Text="{Binding Settings.CompanyPhone, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Phone Number"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 FontSize="13"
                                 Margin="0,0,0,12"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />

                        <!-- Email -->
                        <TextBox Text="{Binding Settings.CompanyEmail, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Email Address"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 FontSize="13"
                                 Margin="0,0,0,12"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />

                        <!-- Currency Symbol -->
                        <TextBox Text="{Binding Settings.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Currency Symbol"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 FontSize="13"
                                 Width="140"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />
                    </StackPanel>
                </Border>

                <!-- Section 2: Sales Tax -->
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Sales Tax"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   Margin="0,0,0,14" />

                        <CheckBox Content="Enable sales tax on invoices"
                                  IsChecked="{Binding Settings.TaxEnabled}"
                                  FontSize="13"
                                  Margin="0,0,0,14"
                                  Style="{StaticResource MahApps.Styles.CheckBox}" />

                        <TextBox Text="{Binding Settings.TaxPercentage, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Tax Percentage (%)"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 FontSize="13"
                                 Width="160"
                                 HorizontalAlignment="Left"
                                 IsEnabled="{Binding Settings.TaxEnabled}"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />
                    </StackPanel>
                </Border>

                <!-- Section 3: Document Numbering -->
                <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Document Numbering"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MahApps.Brushes.Text}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Prefixes used for auto-generated numbers, e.g. INV-2026-0001. Changing a prefix does not affect numbers already issued."
                                   FontSize="12"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding Settings.JobPrefix, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Job Prefix"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     FontSize="13"
                                     Style="{StaticResource MahApps.Styles.TextBox}" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding Settings.InvoicePrefix, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Invoice Prefix"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     FontSize="13"
                                     Style="{StaticResource MahApps.Styles.TextBox}" />

                            <TextBox Grid.Column="4"
                                     Text="{Binding Settings.QuotationPrefix, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Quotation Prefix"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     FontSize="13"
                                     Style="{StaticResource MahApps.Styles.TextBox}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status & Error Messages -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D92D20"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#067647"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- Save Action Button -->
                <Button Content="Save Settings"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Width="160"
                        Height="36"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>