<UserControl x:Class="CNCPlasmaERP.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <TabControl Margin="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
        <TabItem Header="Profit &amp; Loss" DataContext="{Binding ProfitLoss}">
            <views:ProfitLossReportView/>
        </TabItem>
        <TabItem Header="Stock Report" IsEnabled="{Binding CanViewStockReport}" DataContext="{Binding StockReport}">
            <views:StockReportView/>
        </TabItem>
    </TabControl>
</UserControl>
