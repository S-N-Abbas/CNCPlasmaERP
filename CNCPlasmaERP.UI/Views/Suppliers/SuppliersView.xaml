<UserControl x:Class="CNCPlasmaERP.UI.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Suppliers DataGrid -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Suppliers}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="38"
                      Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Contact"
                                        Binding="{Binding ContactPerson}"
                                        Width="140" />

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        Width="120" />

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Right Side: Add Supplier Form -->
        <Border Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Add Supplier"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"
                               Margin="0,0,0,16" />

                    <!-- Supplier Name -->
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Supplier Name"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Contact Person -->
                    <TextBox Text="{Binding NewContactPerson, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Contact Person (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Phone -->
                    <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Phone (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Email -->
                    <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Email (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Address -->
                    <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Address (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             AcceptsReturn="True"
                             Height="65"
                             TextWrapping="Wrap"
                             FontSize="13"
                             Margin="0,0,0,16"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Error Display -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D92D20"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Action Button -->
                    <Button Content="Add Supplier"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Command="{Binding AddSupplierCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>