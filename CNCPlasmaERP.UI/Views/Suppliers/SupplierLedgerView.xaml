<UserControl x:Class="CNCPlasmaERP.UI.Views.SupplierLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="14" Margin="0,0,0,12" CornerRadius="6"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Supplier" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                              DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                              Style="{StaticResource MahApps.Styles.ComboBox}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="Balance owed: " FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedSupplier.CurrentBalance, StringFormat=N2}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="From"/><DatePicker SelectedDate="{Binding FromDate}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="To"/><DatePicker SelectedDate="{Binding ToDate}"/></StackPanel>
                <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0,12,14,0"/>
                <Border Grid.Column="4" Padding="12" CornerRadius="4" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Record payment" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PaymentAmount, Converter={StaticResource DecimalTextConverter}, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Amount" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Content="Record Payment" Command="{Binding RecordPaymentCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                        <TextBlock Text="Payments above the balance create a supplier credit." FontSize="11" Foreground="{DynamicResource MahApps.Brushes.Gray3}" Margin="0,4,0,0"/>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Reference (optional)" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Notes (optional)"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36"
                      Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat=dd-MMM-yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                    <DataGridTextColumn Header="Reference / Notes" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTextColumn Header="Debit (paid)" Binding="{Binding Debit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="Credit (owed)" Binding="{Binding Credit, StringFormat=N2}" Width="130"/>
                    <DataGridTextColumn Header="Balance owed" Binding="{Binding RunningBalance, StringFormat=N2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,10,0" IsHitTestVisible="False">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#16804A" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
