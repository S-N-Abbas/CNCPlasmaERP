<UserControl x:Class="CNCPlasmaERP.UI.Views.StockPurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding RecentPurchases}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat=dd-MMM-yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Material" Binding="{Binding Material.Name}" Width="*"/>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.Name}" Width="140"/>
                    <DataGridTextColumn Header="Weight (Kg)" Binding="{Binding WeightKg, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Rate/Kg" Binding="{Binding RatePerKg, StringFormat=N2}" Width="80"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalCost, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E4E7EC" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Record Purchase" FontSize="15" FontWeight="SemiBold" Foreground="#101828" Margin="0,0,0,14"/>

                <TextBlock Text="Material" FontSize="12" Foreground="#344054"/>
                <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberPath="Name"/>

                <TextBlock Text="Supplier" FontSize="12" Foreground="#344054"/>
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0" ToolTip="New supplier name"/>
                    <Button Grid.Column="2" Content="+ Add" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddSupplierCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                </Grid>

                <TextBlock Text="Weight (Kg)" FontSize="12" Foreground="#344054"/>
                <TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Sheet Count (optional)" FontSize="12" Foreground="#344054"/>
                <TextBox Text="{Binding SheetCount, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Rate / Kg" FontSize="12" Foreground="#344054"/>
                <TextBox Text="{Binding RatePerKg, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Carriage Cost (optional)" FontSize="12" Foreground="#344054"/>
                <TextBox Text="{Binding CarriageCost, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Supplier Invoice # (optional)" FontSize="12" Foreground="#344054"/>
                <TextBox Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Notes (optional)" FontSize="12" Foreground="#344054"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="50" TextWrapping="Wrap"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#D92D20" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Content="Record Purchase" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RecordPurchaseCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
