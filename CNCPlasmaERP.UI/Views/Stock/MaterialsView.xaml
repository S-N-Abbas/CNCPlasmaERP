<UserControl x:Class="CNCPlasmaERP.UI.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Materials DataGrid -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding Materials}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="38"
                      Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="100" />

                    <DataGridTextColumn Header="Gauge"
                                        Binding="{Binding Gauge}"
                                        Width="100" />

                    <DataGridTextColumn Header="Stock (Kg)"
                                        Binding="{Binding CurrentStockKg, StringFormat=N2}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Sheets"
                                        Binding="{Binding CurrentStockCount}"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Reorder (Kg)"
                                        Binding="{Binding ReorderLevelKg, StringFormat=N2}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Right Side: Add Material Form -->
        <Border Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Add Material"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"
                               Margin="0,0,0,16" />

                    <!-- Material Name -->
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Material Name"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Material Type Select -->
                    <ComboBox ItemsSource="{Binding MaterialTypes}"
                              SelectedItem="{Binding NewType}"
                              mah:TextBoxHelper.Watermark="Type"
                              mah:TextBoxHelper.UseFloatingWatermark="True"
                              FontSize="13"
                              Margin="0,0,0,12"
                              Style="{StaticResource MahApps.Styles.ComboBox}" />

                    <!-- Gauge / Thickness -->
                    <TextBox Text="{Binding NewGauge, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Gauge / Thickness"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Default Rate / Kg -->
                    <TextBox Text="{Binding NewDefaultRatePerKg, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Default Rate / Kg (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Reorder Level -->
                    <TextBox Text="{Binding NewReorderLevelKg, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Reorder Level (Kg, optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,16"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Error Display -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D92D20"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Action Button -->
                    <Button Content="Add Material"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Command="{Binding AddMaterialCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>