<UserControl x:Class="CNCPlasmaERP.UI.Views.StockPurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: Recent Purchases DataGrid -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Margin="0,0,16,0">
            <DataGrid ItemsSource="{Binding RecentPurchases}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="38"
                      Style="{StaticResource MahApps.Styles.DataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding PurchaseDate, StringFormat=dd-MMM-yyyy}"
                                        Width="100" />

                    <DataGridTextColumn Header="Material"
                                        Binding="{Binding Material.Name}"
                                        Width="*" />

                    <DataGridTextColumn Header="Supplier"
                                        Binding="{Binding Supplier.Name}"
                                        Width="140" />

                    <DataGridTextColumn Header="Weight (Kg)"
                                        Binding="{Binding WeightKg, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Rate/Kg"
                                        Binding="{Binding RatePerKg, StringFormat=N2}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total Cost"
                                        Binding="{Binding TotalCost, StringFormat=N2}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                        Value="Right" />
                                <Setter Property="Margin"
                                        Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Right Side: Record Purchase Form -->
        <Border Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                CornerRadius="6"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="1"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Record Purchase"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"
                               Margin="0,0,0,16" />

                    <!-- Material Select -->
                    <ComboBox ItemsSource="{Binding Materials}"
                              SelectedItem="{Binding SelectedMaterial}"
                              DisplayMemberPath="Name"
                              mah:TextBoxHelper.Watermark="Material"
                              mah:TextBoxHelper.UseFloatingWatermark="True"
                              FontSize="13"
                              Margin="0,0,0,12"
                              Style="{StaticResource MahApps.Styles.ComboBox}" />

                    <!-- Supplier Select -->
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Name"
                              StaysOpenOnEdit="True"
                              DisplayMemberPath="Name"
                              mah:TextBoxHelper.Watermark="Supplier"
                              mah:TextBoxHelper.UseFloatingWatermark="True"
                              FontSize="13"
                              Margin="0,0,0,12"
                              Style="{StaticResource MahApps.Styles.ComboBox}" />

                    <!-- Add New Supplier Inline Control -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="New Supplier Name"
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 FontSize="13"
                                 Style="{StaticResource MahApps.Styles.TextBox}" />

                        <Button Grid.Column="2"
                                Content="+ Add"
                                Style="{StaticResource SecondaryButton}"
                                Height="34"
                                VerticalAlignment="Bottom"
                                Command="{Binding AddSupplierCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    </Grid>

                    <!-- Weight (Kg) -->
                    <TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Weight (Kg)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Sheet Count -->
                    <TextBox Text="{Binding SheetCount, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Sheet Count (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Rate / Kg -->
                    <TextBox Text="{Binding RatePerKg, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Rate / Kg"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Carriage Cost -->
                    <TextBox Text="{Binding CarriageCost, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Carriage Cost (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Supplier Invoice # -->
                    <TextBox Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Supplier Invoice # (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             mah:TextBoxHelper.ClearTextButton="True"
                             FontSize="13"
                             Margin="0,0,0,12"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Notes -->
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Notes (optional)"
                             mah:TextBoxHelper.UseFloatingWatermark="True"
                             AcceptsReturn="True"
                             Height="60"
                             TextWrapping="Wrap"
                             FontSize="13"
                             Margin="0,0,0,16"
                             Style="{StaticResource MahApps.Styles.TextBox}" />

                    <!-- Error Display -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D92D20"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Action Button -->
                    <Button Content="Record Purchase"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Command="{Binding RecordPurchaseCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>