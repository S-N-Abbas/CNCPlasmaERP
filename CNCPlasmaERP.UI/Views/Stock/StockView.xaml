<UserControl x:Class="CNCPlasmaERP.UI.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <TabControl Margin="0" Background="Transparent" BorderThickness="0">
        <TabItem Header="Materials" DataContext="{Binding Materials}">
            <views:MaterialsView/>
        </TabItem>
        <TabItem Header="Purchases" DataContext="{Binding Purchases}">
            <views:StockPurchaseView/>
        </TabItem>
        <TabItem Header="Scrap" DataContext="{Binding Scrap}">
            <views:ScrapView/>
        </TabItem>
    </TabControl>
</UserControl>
