<UserControl x:Class="CNCPlasmaERP.UI.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views">
    <Grid Margin="16">
        <TabControl Style="{StaticResource MahApps.Styles.TabControl}"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    BorderThickness="0">
            <!-- Materials Sub-View Tab -->
            <TabItem Header="Materials"
                     DataContext="{Binding Materials}"
                     FontSize="14"
                     FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <views:MaterialsView />
                </Grid>
            </TabItem>

            <!-- Purchases Sub-View Tab -->
            <TabItem Header="Purchases"
                     DataContext="{Binding Purchases}"
                     FontSize="14"
                     FontWeight="SemiBold">
                <Grid Margin="0,12,0,0">
                    <views:StockPurchaseView />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>