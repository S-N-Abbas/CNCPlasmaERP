<mah:MetroWindow x:Class="CNCPlasmaERP.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:CNCPlasmaERP.UI.ViewModels"
                 xmlns:views="clr-namespace:CNCPlasmaERP.UI.Views"
                 Title="CNC Plasma ERP"
                 Height="720"
                 Width="1200"
                 WindowStartupLocation="CenterScreen"
                 TitleAlignment="Left"
                 SaveWindowPosition="True"
                 WindowTransitionsEnabled="True"
                 Background="{DynamicResource MahApps.Brushes.ThemeBackground}">

    <mah:MetroWindow.Resources>
        <!-- DataTemplates for ViewModel routing -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:JobsViewModel}">
            <views:JobsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InvoicingViewModel}">
            <views:InvoicingView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
            <views:ExpensesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App Brand & User Details -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,24,20,20">
                    <TextBlock Text="CNC Plasma ERP"
                               Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                               FontSize="17"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding LoggedInUserDisplay}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Logout Action Button -->
                <Button DockPanel.Dock="Bottom"
                        Content="Logout"
                        Style="{StaticResource NavButton}"
                        Command="{Binding LogoutCommand}"
                        Margin="8,2,8,20" />

                <!-- Navigation Item List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />
                                                    <Setter Property="FontWeight"
                                                            Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="0" />
    </Grid>
</mah:MetroWindow>